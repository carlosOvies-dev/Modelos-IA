# Si dejas la clave vacia el programa usa Ollama por defecto, si pones tu clave usa Gemini
API_KEY_IA=

# Nombre del modelo de Gemini a usar cuando hay clave
MODELO_GEMINI=gemini-2.5-flash

# Modelo local descargado en Ollama y la direccion compatible con OpenAI
MODELO_OLLAMA=qwen2.5:7b-instruct
URL_OLLAMA=http://localhost:11434/v1

# Modelo de embeddings para convertir texto en vectores
MODELO_EMBEDDINGS=BAAI/bge-m3
